@model PaymentDetailsVm

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mt-2">
            <i class="fas fa-file-invoice-dollar me-2"></i>Payment Details
        </h1>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Payments</a></li>
        <li class="breadcrumb-item active">Details</li>
    </ol>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-money-check-alt me-1"></i> Payment #@Model.Id</span>
            @{
                var badgeClass = Model.Status.ToString() switch
                {
                    "Pending" => "bg-warning text-dark",
                    "Completed" => "bg-success",
                    "Failed" => "bg-danger",
                    "Refunded" => "bg-secondary",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @badgeClass fs-6">@Model.Status</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Booking Reference</dt>
                <dd class="col-sm-9">@Model.BookingReference</dd>

                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>

                <dt class="col-sm-3">Payment Method</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3">Transaction Reference</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-light text-dark border">@Model.TransactionReference</span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
            </dl>
        </div>
        <div class="card-footer d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="fas fa-edit me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>
