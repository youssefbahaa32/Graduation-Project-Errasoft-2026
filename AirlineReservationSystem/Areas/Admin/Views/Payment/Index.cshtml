@model PagedResultVm<PaymentListItemVm>

@{
    ViewData["Title"] = "Payments";
}

<div class="container-fluid px-4 py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mt-2">
            <i class="fas fa-money-check-alt me-2"></i>Payments
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add New Payment
        </a>
    </div>

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
        <li class="breadcrumb-item active">Payments</li>
    </ol>

    <!-- Search Card -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-filter me-1"></i> Search
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text"
                               name="searchTransactionRef"
                               value="@Model.CurrentSearch"
                               class="form-control"
                               placeholder="Search by transaction reference..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(Model.CurrentSearch))
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i> Clear
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Payments List
        </div>
        <div class="card-body">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No payments found.</p>
                </div>
            }
            else
            {
                <table class="table table-hover" id="paymentsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Booking Ref</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Transaction Ref</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Items)
                        {
                            <tr>
                                <td>@payment.Id</td>
                                <td class="fw-semibold">@payment.BookingReference</td>
                                <td>@payment.Amount.ToString("N2")</td>
                                <td>@payment.PaymentMethod</td>
                                <td>
                                    @{
                                        var badgeClass = payment.Status.ToString() switch
                                        {
                                            "Pending" => "bg-warning text-dark",
                                            "Completed" => "bg-success",
                                            "Failed" => "bg-danger",
                                            "Refunded" => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass">@payment.Status</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @payment.TransactionReference
                                    </span>
                                </td>
                                <td>@payment.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@payment.Id"
                                           class="btn btn-outline-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@payment.Id"
                                           class="btn btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-delete"
                                                data-id="@payment.Id"
                                                data-name="@payment.TransactionReference"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Pagination -->
        @if (Model.Items.Any())
        {
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted">
                    Showing page @Model.PageNumber of @Model.TotalPages
                    (@Model.TotalCount total payment@(Model.TotalCount == 1 ? "" : "s"))
                </small>

                <nav aria-label="Payments pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="1"
                               asp-route-searchTransactionRef="@Model.CurrentSearch">
                                <i class="fas fa-angle-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-searchTransactionRef="@Model.CurrentSearch">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        </li>

                        @{
                            int startPage = Math.Max(1, Model.PageNumber - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-searchTransactionRef="@Model.CurrentSearch">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-searchTransactionRef="@Model.CurrentSearch">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@Model.TotalPages"
                               asp-route-searchTransactionRef="@Model.CurrentSearch">
                                <i class="fas fa-angle-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Delete confirmation form (hidden) -->
<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteId" name="id" value="" />
</form>

@section Scripts {
    <script>
        // Toastr messages from TempData
        @if (TempData["success-notification"] is not null)
        {
                <text>toastr.success('@TempData["success-notification"]');</text>
        }
        @if (TempData["error-notification"] is not null)
        {
                <text>toastr.error('@TempData["error-notification"]');</text>
        }

        // SweetAlert2 delete confirmation
        document.querySelectorAll('.btn-delete').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const id = this.dataset.id;
                const name = this.dataset.name;

                Swal.fire({
                    title: 'Are you sure?',
                    text: `Do you want to delete payment with transaction ref "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('deleteId').value = id;
                        document.getElementById('deleteForm').submit();
                    }
                });
            });
        });
    </script>
}
