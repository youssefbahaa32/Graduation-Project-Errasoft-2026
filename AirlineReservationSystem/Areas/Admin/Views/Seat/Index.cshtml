@model SeatIndexVM

@{
    ViewData["Title"] = "Seats";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h1>

            <i class="fas fa-chair me-2"></i>

            Seats

        </h1>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>

            Add Seat

        </a>

    </div>

    <div class="card shadow mb-4">

        <div class="card-body">

            <form method="get">

                <div class="row g-3">

                    <div class="col-md-4">

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="Search..." />

                    </div>

                    <div class="col-md-3">

                        <select asp-for="AircraftId"
                                asp-items="Model.Aircrafts"
                                class="form-select">

                            <option value="">All Aircrafts</option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <select asp-for="SeatClass"
                                asp-items="Html.GetEnumSelectList<SeatClass>()"
                                class="form-select">

                            <option value="">All Classes</option>

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button class="btn btn-success w-100">

                            <i class="fas fa-search"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-hover table-bordered">

                <thead class="table-dark">

                    <tr>

                        <th>Seat Number</th>

                        <th>Seat Class</th>

                        <th>Aircraft</th>

                        <th width="180">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var seat in Model.Seats)
                    {
                        <tr>

                            <td>@seat.SeatNumber</td>

                            <td>@seat.SeatClass</td>

                            <td>@seat.Aircraft</td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@seat.Id"
                                   class="btn btn-info btn-sm">

                                    <i class="fas fa-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@seat.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="fas fa-edit"></i>

                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@seat.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button class="btn btn-danger btn-sm"
                                            onclick="return confirm('Delete this seat?')">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>