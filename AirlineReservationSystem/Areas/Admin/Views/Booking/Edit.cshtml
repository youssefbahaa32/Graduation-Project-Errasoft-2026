@model AirlineReservationSystem.ViewModels.BookingVM.EditBookingVM

@{
    ViewData["Title"] = "Update Booking Status";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-white py-3">
                    <h4 class="card-title mb-0 text-center text-dark">
                        <i class="fas fa-edit"></i> Update Booking Status
                    </h4>
                </div>
                <div class="card-body p-4">
                    <!-- ملخص بيانات الحجز المقفل -->
                    <div class="bg-light p-3 rounded mb-4 border">
                        <div class="row g-2">
                            <div class="col-6 text-muted fw-bold">Reference:</div>
                            <div class="col-6 text-primary fw-bold">@Model.BookingReference</div>

                            <div class="col-6 text-muted fw-bold">Customer:</div>
                            <div class="col-6">@Model.CustomerName</div>

                            <div class="col-6 text-muted fw-bold">Flight Number:</div>
                            <div class="col-6"><span class="badge bg-secondary">@Model.FlightNumber</span></div>
                        </div>
                    </div>

                    <!-- فورم التعديل -->
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="BookingReference" />
                        <input type="hidden" asp-for="CustomerName" />
                        <input type="hidden" asp-for="FlightNumber" />

                        <!-- ملخص أخطاء السيرفر (إن وجدت) -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold">Choose New Status</label>
                            <select asp-for="Status" class="form-select form-select-lg"
                                    asp-items="Html.GetEnumSelectList<BookingStatus>()">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
