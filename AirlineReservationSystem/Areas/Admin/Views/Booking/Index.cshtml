@model AirlineReservationSystem.ViewModels.BookingVM.BookingListVM

@{
    ViewData["Title"] = "Bookings Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-ticket-alt text-primary"></i> Bookings Management</h2>
    </div>

    <!-- 1. فورم الفلترة والبحث -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0"><i class="fas fa-filter text-secondary"></i> Filter Bookings</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Filter.Keyword" class="form-label">Search</label>
                    <input asp-for="Filter.Keyword" class="form-control" placeholder="Ref, Customer Name..." />
                </div>
                <div class="col-md-2">
                    <label asp-for="Filter.BookingStatus" class="form-label">Booking Status</label>
                    <select asp-for="Filter.BookingStatus" class="form-select" asp-items="Html.GetEnumSelectList<AirlineReservationSystem.Models.Enums.BookingStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Filter.PaymentStatus" class="form-label">Payment Status</label>
                    <select asp-for="Filter.PaymentStatus" class="form-select" asp-items="Html.GetEnumSelectList<AirlineReservationSystem.Models.Enums.PaymentStatus>()">
                        <option value="">All Payments</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Filter.FromDate" class="form-label">From Date</label>
                    <input asp-for="Filter.FromDate" class="form-control" type="date" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Filter.ToDate" class="form-label">To Date</label>
                    <input asp-for="Filter.ToDate" class="form-control" type="date" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i></button>
                </div>
            </form>
        </div>
    </div>

    <!-- رسائل النجاح أو الخطأ القادمة من الـ Controller -->
    @if (TempData["success-notification"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["success-notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["error-notification"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["error-notification"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 2. جدول عرض البيانات -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Reference</th>
                            <th>Customer</th>
                            <th>Flight</th>
                            <th>Passengers</th>
                            <th>Amount</th>
                            <th>Booking Status</th>
                            <th>Payment Status</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Bookings != null && Model.Bookings.Any())
                        {
                            foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td><strong class="text-primary">@booking.BookingReference</strong></td>
                                    <td>@booking.CustomerName</td>
                                    <td><span class="badge bg-secondary">@booking.FlightNumber</span></td>
                                    <td>@booking.PassengersCount</td>
                                    <td>@booking.TotalAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge @(booking.Status == AirlineReservationSystem.Models.Enums.BookingStatus.Cancelled ? "bg-danger" : booking.Status == AirlineReservationSystem.Models.Enums.BookingStatus.Confirmed ? "bg-success" : "bg-warning")">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(booking.PaymentStatus == AirlineReservationSystem.Models.Enums.PaymentStatus.Paid ? "bg-success" : booking.PaymentStatus == AirlineReservationSystem.Models.Enums.PaymentStatus.Failed ? "bg-danger" : "bg-warning")">
                                            @(booking.PaymentStatus?.ToString() ?? "No Payment")
                                        </span>
                                    </td>
                                    <td>@booking.CreatedAt.ToString("g")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-info text-white" title="Details">
                                                <i class="fas fa-eye"></i> View
                                            </a>

                                            @if (booking.Status != AirlineReservationSystem.Models.Enums.BookingStatus.Cancelled)
                                            {
                                                <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-warning text-white" title="Change Status">
                                                    <i class="fas fa-edit"></i> Status
                                                </a>
                                                <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');" style="display:inline;">
                                                    <button type="submit" class="btn btn-danger" title="Cancel Booking">
                                                        <i class="fas fa-times-circle"></i> Cancel
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-folder-open fa-2x mb-2 d-block"></i> No bookings found matching your criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. أزرار التنقل بين الصفحات (Pagination) -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light d-flex justify-content-between align-middle pt-3">
                <div>
                    Showing <span class="fw-bold">@(((Model.CurrentPage - 1) * Model.Filter.PageSize) + 1)</span>
                    to <span class="fw-bold">@(Math.Min(Model.CurrentPage * Model.Filter.PageSize, Model.TotalCount))</span>
                    of <span class="fw-bold">@Model.TotalCount</span> bookings.
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-Filter.PageNumber="@(Model.CurrentPage - 1)"
                               asp-route-Filter.Keyword="@Model.Filter.Keyword"
                               asp-route-Filter.BookingStatus="@Model.Filter.BookingStatus"
                               asp-route-Filter.PaymentStatus="@Model.Filter.PaymentStatus"
                               asp-route-Filter.FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-Filter.ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Filter.PageNumber="@i"
                                   asp-route-Filter.Keyword="@Model.Filter.Keyword"
                                   asp-route-Filter.BookingStatus="@Model.Filter.BookingStatus"
                                   asp-route-Filter.PaymentStatus="@Model.Filter.PaymentStatus"
                                   asp-route-Filter.FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-Filter.ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-Filter.PageNumber="@(Model.CurrentPage + 1)"
                               asp-route-Filter.Keyword="@Model.Filter.Keyword"
                               asp-route-Filter.BookingStatus="@Model.Filter.BookingStatus"
                               asp-route-Filter.PaymentStatus="@Model.Filter.PaymentStatus"
                               asp-route-Filter.FromDate="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")"
                               asp-route-Filter.ToDate="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

