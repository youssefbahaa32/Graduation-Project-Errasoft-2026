@model AirlineReservationSystem.ViewModels.PassengerCustomerVM.PassengerInfoVM

@section Styles {
    <style>
        .passenger-container {
            max-width: 900px;
            margin: 2rem auto;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-title {
            font-weight: 700;
            color: #2c3e50;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .passenger-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            margin-bottom: 2rem;
            overflow: hidden;
        }

        .passenger-card-header {
            background-color: #1a365d;
            color: #ffffff;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e2e8f0;
        }

        .passenger-card-header h5 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 600;
        }

        .seat-badge {
            background-color: #ebf8ff;
            color: #2b6cb0;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .passenger-card-body {
            padding: 1.5rem;
            background-color: #f8fafc;
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -10px;
            margin-left: -10px;
        }

        .form-group {
            flex: 0 0 50%;
            max-width: 50%;
            padding: 0 10px;
            margin-bottom: 1.25rem;
            box-sizing: border-box;
            text-align: left;
        }

        .form-group.full-width {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #4a5568;
            font-size: 0.9rem;
        }

        .form-control, .form-select {
            display: block;
            width: 100%;
            padding: 0.6rem 0.75rem;
            font-size: 0.95rem;
            line-height: 1.5;
            color: #2d3748;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid #cbd5e0;
            border-radius: 0.375rem;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            box-sizing: border-box;
        }

        .form-control:focus, .form-select:focus {
            border-color: #3182ce;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.25);
        }

        .btn-container {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            margin-bottom: 3rem;
        }

        .btn-submit {
            background-color: #2f855a;
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-submit:hover {
            background-color: #22543d;
        }

        .btn-back {
            background-color: #718096;
            color: white;
            text-decoration: none;
            padding: 0.75rem 2rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 0.375rem;
            transition: background-color 0.2s;
            display: inline-block;
        }

        .btn-back:hover {
            background-color: #4a5568;
            color: white;
        }

        .text-danger {
            color: #e53e3e;
            font-size: 0.8rem;
            margin-top: 0.25rem;
            display: block;
        }
    </style>
}

<div class="passenger-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 class="page-title">Passenger Information</h2>
        <span style="color: #718096; font-weight: 600;">Flight ID: @Model.FlightId</span>
    </div>
    <hr style="border: 0; border-top: 1px solid #e2e8f0; margin-bottom: 2rem;" />

    <form asp-action="PassengerInfo" method="post">
        <!-- الحقول المخفية الأساسية للـ Form -->
        <input type="hidden" asp-for="FlightId" />

        @for (int i = 0; i < Model.Passengers.Count; i++)
        {
            <div class="passenger-card">
                <div class="passenger-card-header">
                    <h5>Passenger #@(i + 1)</h5>
                    <span class="seat-badge">Seat: @Model.Passengers[i].SeatNumber</span>
                </div>
                <div class="passenger-card-body">
                    <!-- حقول مخفية لنقل بيانات المقاعد بأمان في الـ POST -->
                    <input type="hidden" asp-for="Passengers[i].FlightSeatId" />
                    <input type="hidden" asp-for="Passengers[i].SeatNumber" />

                    <!-- الصف الأول: الاسم الأول واسم العائلة -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Passengers[i].FirstName" class="form-label">First Name</label>
                            <input asp-for="Passengers[i].FirstName" class="form-control" placeholder="Enter first name" />
                            <span asp-validation-for="Passengers[i].FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Passengers[i].LastName" class="form-label">Last Name</label>
                            <input asp-for="Passengers[i].LastName" class="form-control" placeholder="Enter last name" />
                            <span asp-validation-for="Passengers[i].LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- الصف الثاني: رقم جواز السفر والجنسية -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Passengers[i].PassportNumber" class="form-label">Passport Number</label>
                            <input asp-for="Passengers[i].PassportNumber" class="form-control" placeholder="Enter passport number" />
                            <span asp-validation-for="Passengers[i].PassportNumber" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Passengers[i].Nationality" class="form-label">Nationality</label>
                            <input asp-for="Passengers[i].Nationality" class="form-control" placeholder="Enter nationality" />
                            <span asp-validation-for="Passengers[i].Nationality" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- الصف الثالث: تاريخ الميلاد وتاريخ انتهاء جواز السفر -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Passengers[i].DateOfBirth" class="form-label">Date of Birth</label>
                            <!-- خدعة إخفاء التاريخ البدائي الصفرى 01/01/0001 -->
                            <input asp-for="Passengers[i].DateOfBirth" type="date" class="form-control" 
                                   value="@(Model.Passengers[i].DateOfBirth == DateTime.MinValue ? "" : Model.Passengers[i].DateOfBirth.ToString("yyyy-MM-dd"))" />
                            <span asp-validation-for="Passengers[i].DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Passengers[i].PassportExpiryDate" class="form-label">Passport Expiry Date</label>
                            <!-- خدعة إخفاء التاريخ البدائي الصفرى 01/01/0001 -->
                            <input asp-for="Passengers[i].PassportExpiryDate" type="date" class="form-control" 
                                   value="@(Model.Passengers[i].PassportExpiryDate == DateTime.MinValue ? "" : Model.Passengers[i].PassportExpiryDate.ToString("yyyy-MM-dd"))" />
                            <span asp-validation-for="Passengers[i].PassportExpiryDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- الصف الرابع: تحديد الجنس -->
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Passengers[i].Gender" class="form-label">Gender</label>
                            <select asp-for="Passengers[i].Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Passengers[i].Gender" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- أزرار التحكم -->
        <div class="btn-container">
            <button type="submit" class="btn-submit">Proceed to Luggage</button>
            <a asp-action="SelectSeats" asp-controller="Flight" asp-route-flightId="@Model.FlightId" class="btn-back">Back to Seats</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}