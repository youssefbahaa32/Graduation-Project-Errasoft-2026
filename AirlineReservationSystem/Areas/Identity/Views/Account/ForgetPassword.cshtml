@model ForgetPasswordVM
@{
    ViewData["Title"] = "ForgetPassword";
}


@section Styles {
<style>
    :root {
        --sky-blue: #0d6efd;
        --sky-blue-dark: #0a58ca;
        --sky-navy: #0b2447;
        --gold: #f5b301;
    }

    .fp-page {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(180deg, #0b2447 0%, #164a7a 35%, #3d7cb8 65%, #bcd9ef 100%);
        padding: 40px 15px;
    }

    /* Clouds (pure CSS, no external images needed) */
    .fp-cloud {
        position: absolute;
        background: rgba(255, 255, 255, 0.55);
        border-radius: 50%;
        filter: blur(1px);
        opacity: 0.7;
    }

        .fp-cloud::before, .fp-cloud::after {
            content: "";
            position: absolute;
            background: inherit;
            border-radius: 50%;
        }

    .cloud1 {
        width: 140px;
        height: 45px;
        top: 12%;
        left: 8%;
        animation: floatX 30s linear infinite;
    }

        .cloud1::before {
            width: 70px;
            height: 70px;
            top: -35px;
            left: 15px;
        }

        .cloud1::after {
            width: 55px;
            height: 55px;
            top: -25px;
            left: 70px;
        }

    .cloud2 {
        width: 100px;
        height: 35px;
        top: 22%;
        right: 12%;
        animation: floatX 40s linear infinite reverse;
    }

        .cloud2::before {
            width: 55px;
            height: 55px;
            top: -28px;
            left: 10px;
        }

        .cloud2::after {
            width: 40px;
            height: 40px;
            top: -18px;
            left: 55px;
        }

    .cloud3 {
        width: 160px;
        height: 50px;
        top: 65%;
        left: 4%;
        opacity: 0.35;
        animation: floatX 50s linear infinite;
    }

        .cloud3::before {
            width: 80px;
            height: 80px;
            top: -40px;
            left: 20px;
        }

        .cloud3::after {
            width: 60px;
            height: 60px;
            top: -28px;
            left: 85px;
        }

    .cloud4 {
        width: 120px;
        height: 40px;
        top: 75%;
        right: 8%;
        opacity: 0.3;
        animation: floatX 45s linear infinite reverse;
    }

        .cloud4::before {
            width: 60px;
            height: 60px;
            top: -30px;
            left: 10px;
        }

        .cloud4::after {
            width: 45px;
            height: 45px;
            top: -20px;
            left: 65px;
        }

    @@keyframes floatX {
        0% {
            transform: translateX(0);
        }

        50% {
            transform: translateX(40px);
        }

        100% {
            transform: translateX(0);
        }
    }

    /* Flight path + plane */
    .fp-plane {
        position: absolute;
        top: 40%;
        left: -10%;
        font-size: 2rem;
        color: rgba(255, 255, 255, 0.8);
        animation: flyAcross 18s linear infinite;
        z-index: 1;
    }

    @@keyframes flyAcross {
        0% {
            left: -10%;
            top: 42%;
            transform: rotate(8deg);
        }

        50% {
            left: 55%;
            top: 15%;
            transform: rotate(8deg);
        }

        100% {
            left: 115%;
            top: 5%;
            transform: rotate(8deg);
        }
    }

    .fp-dots {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.15) 1.5px, transparent 1.5px);
        background-size: 26px 26px;
        opacity: 0.5;
    }

    /* Card */
    .fp-card {
        position: relative;
        z-index: 2;
        max-width: 520px;
        width: 100%;
        margin: 0 auto;
        border-radius: 22px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.97);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    .fp-header {
        background: linear-gradient(120deg, var(--sky-blue) 0%, var(--sky-blue-dark) 100%);
        color: #fff;
        text-align: center;
        padding: 38px 30px 32px;
        position: relative;
    }

    .fp-header-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        border: 2px solid rgba(255, 255, 255, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 1.8rem;
    }

    .fp-header h2 {
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: 0.3px;
    }

    .fp-header small {
        opacity: 0.9;
        font-size: 0.95rem;
    }

    .fp-ticket-strip {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 14px;
        background-image: radial-gradient(circle at 10px 0, transparent 8px, var(--sky-blue-dark) 8px);
        background-size: 20px 16px;
        background-position: 0 -8px;
    }

    .fp-body {
        padding: 45px 45px 30px;
    }

    .fp-lead {
        text-align: center;
        color: #5b6b7c;
        font-size: 1.02rem;
        margin-bottom: 34px;
    }

    .fp-label {
        font-weight: 600;
        color: #0b2447;
        margin-bottom: 8px;
        font-size: 0.98rem;
    }

    .fp-input-group {
        position: relative;
        margin-bottom: 26px;
    }

        .fp-input-group .fp-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 16px;
            color: #9aa7b5;
            font-size: 1.05rem;
            z-index: 3;
        }

        .fp-input-group input.form-control {
            padding: 14px 16px 14px 44px;
            border-radius: 12px;
            border: 1.5px solid #dfe6ec;
            font-size: 1rem;
            transition: all 0.25s ease;
            background: #f8fafc;
        }

            .fp-input-group input.form-control:focus {
                border-color: var(--sky-blue);
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                background: #fff;
            }

    .fp-submit-btn {
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.3px;
        background: linear-gradient(120deg, var(--sky-blue) 0%, var(--sky-blue-dark) 100%);
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .fp-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(13, 110, 253, 0.4);
        }

    .fp-back-link {
        color: var(--sky-blue-dark) !important;
        font-weight: 600;
        transition: color 0.2s ease;
    }

        .fp-back-link:hover {
            color: var(--sky-blue) !important;
        }

    .fp-footer {
        text-align: center;
        padding: 18px;
        background: #f4f7fa;
        border-top: 1px dashed #dbe3ea;
        color: #7c8a97;
        font-size: 0.88rem;
    }

        .fp-footer i {
            color: var(--sky-blue);
            margin-inline-end: 5px;
        }

    @@media (max-width: 576px) {
        .fp-body {
            padding: 34px 24px 20px;
        }

        .fp-header {
            padding: 30px 20px 26px;
        }
    }
</style>
}
<div class="fp-page">
    <div class="fp-dots"></div>
    <div class="fp-cloud cloud1"></div>
    <div class="fp-cloud cloud2"></div>
    <div class="fp-cloud cloud3"></div>
    <div class="fp-cloud cloud4"></div>
    <i class="fa-solid fa-plane fp-plane"></i>

    <div class="fp-card">
        <!-- Header -->
        <div class="fp-header">
            <div class="fp-header-icon">
                <i class="fa-solid fa-key"></i>
            </div>
            <h2>Forgot Password?</h2>
            <small>We’ll help you reset it quickly</small>
            <div class="fp-ticket-strip"></div>
        </div>

        <!-- Body -->
        <div class="fp-body">
            <p class="fp-lead">
                Enter your email or username and we’ll send you a reset OTP Number
            </p>
            <form asp-action="ForgetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="fp-input-group">
                    <label asp-for="EmailOrUserName" class="fp-label"></label>
                    <i class="fa-regular fa-envelope fp-icon"></i>
                    <input asp-for="EmailOrUserName"
                           class="form-control form-control-lg"
                           placeholder="Enter your email or username" />
                    <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
                </div>

                <div class="d-grid mb-4">
                    <input type="submit"
                           value="Send Reset OTP Number"
                           class="btn btn-primary btn-lg fp-submit-btn text-white" />
                </div>

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none fp-back-link">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Login
                    </a>
                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="fp-footer">
            <i class="fa-solid fa-shield-halved"></i>Secure password reset system
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial">
    }
