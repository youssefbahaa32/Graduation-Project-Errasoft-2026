@model ChangePasswordVM
@{
    ViewData["Title"] = "ChangePassword";
}

@section Styles {
<style>
    :root {
        --sky-blue: #0d6efd;
        --sky-blue-dark: #0a58ca;
        --sky-navy: #0b2447;
    }

    .cp-page {
        min-height: 100vh;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(180deg, #0b2447 0%, #164a7a 35%, #3d7cb8 65%, #bcd9ef 100%);
        padding: 40px 15px;
    }

    .cp-cloud {
        position: absolute;
        background: rgba(255, 255, 255, 0.55);
        border-radius: 50%;
        filter: blur(1px);
        opacity: 0.7;
    }

        .cp-cloud::before, .cp-cloud::after {
            content: "";
            position: absolute;
            background: inherit;
            border-radius: 50%;
        }

    .cloud1 {
        width: 140px;
        height: 45px;
        top: 9%;
        left: 9%;
        animation: floatX 32s linear infinite;
    }

        .cloud1::before {
            width: 70px;
            height: 70px;
            top: -35px;
            left: 15px;
        }

        .cloud1::after {
            width: 55px;
            height: 55px;
            top: -25px;
            left: 70px;
        }

    .cloud2 {
        width: 100px;
        height: 35px;
        top: 24%;
        right: 11%;
        animation: floatX 42s linear infinite reverse;
    }

        .cloud2::before {
            width: 55px;
            height: 55px;
            top: -28px;
            left: 10px;
        }

        .cloud2::after {
            width: 40px;
            height: 40px;
            top: -18px;
            left: 55px;
        }

    .cloud3 {
        width: 155px;
        height: 48px;
        top: 72%;
        left: 6%;
        opacity: 0.32;
        animation: floatX 50s linear infinite;
    }

        .cloud3::before {
            width: 78px;
            height: 78px;
            top: -38px;
            left: 18px;
        }

        .cloud3::after {
            width: 58px;
            height: 58px;
            top: -26px;
            left: 82px;
        }

    @@keyframes floatX {
        0% {
            transform: translateX(0);
        }

        50% {
            transform: translateX(40px);
        }

        100% {
            transform: translateX(0);
        }
    }

    .cp-dots {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.15) 1.5px, transparent 1.5px);
        background-size: 26px 26px;
        opacity: 0.5;
    }

    .cp-plane {
        position: absolute;
        top: 40%;
        left: -10%;
        font-size: 2rem;
        color: rgba(255, 255, 255, 0.8);
        animation: flyAcross 22s linear infinite;
        z-index: 1;
    }

    @@keyframes flyAcross {
        0% {
            left: -10%;
            top: 48%;
            transform: rotate(8deg);
        }

        50% {
            left: 55%;
            top: 14%;
            transform: rotate(8deg);
        }

        100% {
            left: 115%;
            top: 5%;
            transform: rotate(8deg);
        }
    }

    .cp-card {
        position: relative;
        z-index: 2;
        max-width: 540px;
        width: 100%;
        margin: 0 auto;
        border-radius: 22px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.97);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    .cp-header {
        background: linear-gradient(120deg, var(--sky-blue) 0%, var(--sky-blue-dark) 100%);
        color: #fff;
        text-align: center;
        padding: 38px 30px 32px;
        position: relative;
    }

    .cp-header-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        border: 2px solid rgba(255, 255, 255, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        font-size: 1.8rem;
    }

    .cp-header h2 {
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: 0.3px;
    }

    .cp-header small {
        opacity: 0.9;
        font-size: 0.95rem;
    }

    .cp-ticket-strip {
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 100%;
        height: 14px;
        background-image: radial-gradient(circle at 10px 0, transparent 8px, var(--sky-blue-dark) 8px);
        background-size: 20px 16px;
        background-position: 0 -8px;
    }

    .cp-body {
        padding: 45px 45px 30px;
    }

    .cp-lead {
        text-align: center;
        color: #5b6b7c;
        font-size: 1.02rem;
        margin-bottom: 34px;
    }

    .cp-label {
        font-weight: 600;
        color: #0b2447;
        margin-bottom: 8px;
        font-size: 0.98rem;
    }

    .cp-input-group {
        position: relative;
        margin-bottom: 24px;
    }

        .cp-input-group .cp-icon {
            position: absolute;
            top: 44px;
            left: 16px;
            color: #9aa7b5;
            font-size: 1.05rem;
            z-index: 3;
            cursor: pointer;
        }

        .cp-input-group .cp-toggle-eye {
            position: absolute;
            top: 44px;
            right: 16px;
            color: #9aa7b5;
            font-size: 1.05rem;
            z-index: 3;
            cursor: pointer;
        }

        .cp-input-group input.form-control {
            padding: 14px 44px;
            border-radius: 12px;
            border: 1.5px solid #dfe6ec;
            font-size: 1rem;
            transition: all 0.25s ease;
            background: #f8fafc;
        }

            .cp-input-group input.form-control:focus {
                border-color: var(--sky-blue);
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                background: #fff;
            }

    .cp-hint {
        color: #9aa7b5;
        font-size: 0.85rem;
        margin-top: 6px;
        margin-bottom: 0;
    }

    .cp-submit-btn {
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.3px;
        background: linear-gradient(120deg, var(--sky-blue) 0%, var(--sky-blue-dark) 100%);
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .cp-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(13, 110, 253, 0.4);
        }

    .cp-back-link {
        color: var(--sky-blue-dark) !important;
        font-weight: 600;
        transition: color 0.2s ease;
    }

        .cp-back-link:hover {
            color: var(--sky-blue) !important;
        }

    .cp-footer {
        text-align: center;
        padding: 18px;
        background: #f4f7fa;
        border-top: 1px dashed #dbe3ea;
        color: #7c8a97;
        font-size: 0.88rem;
    }

        .cp-footer i {
            color: var(--sky-blue);
            margin-inline-end: 5px;
        }

    @@media (max-width: 576px) {
        .cp-body {
            padding: 34px 24px 20px;
        }

        .cp-header {
            padding: 30px 20px 26px;
        }
    }
</style>
}


<div class="cp-page">
    <div class="cp-dots"></div>
    <div class="cp-cloud cloud1"></div>
    <div class="cp-cloud cloud2"></div>
    <div class="cp-cloud cloud3"></div>
    <i class="fa-solid fa-plane cp-plane"></i>

    <div class="cp-card">
        <!-- Header -->
        <div class="cp-header">
            <div class="cp-header-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h2>Change Password</h2>
            <small>Create a new secure password</small>
            <div class="cp-ticket-strip"></div>
        </div>

        <!-- Body -->
        <div class="cp-body">
            <p class="cp-lead">
                Enter your new password and confirm it to continue
            </p>

            <form asp-action="ChangePassword">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Password -->
                <div class="cp-input-group">
                    <label asp-for="Password" class="cp-label"></label>
                    <i class="fa-solid fa-lock cp-icon"></i>
                    <input asp-for="Password"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <p class="cp-hint">Use at least 8 characters, including a number and a symbol</p>
                </div>

                <!-- Confirm Password -->
                <div class="cp-input-group">
                    <label asp-for="ConfirmPassword" class="cp-label"></label>
                    <i class="fa-solid fa-lock cp-icon"></i>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Submit -->
                <div class="d-grid mb-4 mt-4">
                    <input type="submit"
                           value="Update Password"
                           class="btn btn-primary btn-lg cp-submit-btn text-white" />
                </div>

                <!-- Back -->
                <div class="text-center">
                    <a asp-action="Index" class="text-decoration-none cp-back-link">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="cp-footer">
            <i class="fa-solid fa-shield-halved"></i>Your password is securely updated
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial">
    }
