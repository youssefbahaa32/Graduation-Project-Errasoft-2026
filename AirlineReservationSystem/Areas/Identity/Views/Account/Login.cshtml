@model LoginVM

@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <style>
        .auth-split {
            min-height: 100vh;
            display: flex;
        }

        /* -------- Left visual panel --------
                   In a real project replace the background below with an actual photo:
                   background-image: url('~/images/login-bg.jpg');
                   Put the image file inside wwwroot/images/ and it will show automatically. */
        .auth-visual {
            position: relative;
            flex: 1 1 50%;
            min-height: 100vh;
            background: linear-gradient(160deg, rgba(6,26,64,0.85) 0%, rgba(13,71,161,0.75) 55%, rgba(21,101,192,0.65) 100%), radial-gradient(circle at 20% 30%, rgba(255,255,255,0.08) 0, transparent 40%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.06) 0, transparent 45%), #0a1e42;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
            padding: 50px 55px;
            overflow: hidden;
        }

            .auth-visual::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient(2px 2px at 20% 20%, rgba(255,255,255,0.5) 0, transparent 100%), radial-gradient(2px 2px at 60% 10%, rgba(255,255,255,0.4) 0, transparent 100%), radial-gradient(1.5px 1.5px at 80% 35%, rgba(255,255,255,0.4) 0, transparent 100%), radial-gradient(2px 2px at 40% 60%, rgba(255,255,255,0.3) 0, transparent 100%), radial-gradient(1.5px 1.5px at 90% 80%, rgba(255,255,255,0.3) 0, transparent 100%);
                pointer-events: none;
            }

            .auth-visual .plane-mark {
                font-size: 46px;
                transform: rotate(45deg);
                display: inline-block;
                margin-bottom: 18px;
            }

            .auth-visual .brand-name {
                font-weight: 700;
                font-size: 26px;
                letter-spacing: 1px;
            }

            .auth-visual .tagline {
                font-size: 34px;
                font-weight: 700;
                line-height: 1.3;
                max-width: 460px;
                position: relative;
                z-index: 1;
            }

            .auth-visual .subtext {
                font-size: 15px;
                opacity: 0.75;
                max-width: 420px;
                margin-top: 14px;
            }

            .auth-visual .route-line {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 14px;
                opacity: 0.85;
                margin-top: 40px;
            }

                .auth-visual .route-line .dot {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: #fff;
                }

                .auth-visual .route-line .line {
                    flex: 1;
                    height: 1px;
                    background: repeating-linear-gradient(to right, rgba(255,255,255,0.6) 0 6px, transparent 6px 12px);
                    position: relative;
                    max-width: 160px;
                }

        /* -------- Right form panel -------- */
        .auth-form-panel {
            flex: 1 1 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f7f9fc;
            padding: 40px 20px;
        }

        .auth-form-box {
            width: 100%;
            max-width: 420px;
        }

            .auth-form-box .form-label {
                font-weight: 600;
                font-size: 14px;
                color: #1a2a4a;
            }

            .auth-form-box .form-control {
                border-radius: 10px;
                border: 1px solid #dbe3f0;
                padding: 12px 14px;
                background-color: #fff;
            }

                .auth-form-box .form-control:focus {
                    border-color: #1976d2;
                    box-shadow: 0 0 0 0.2rem rgba(25, 118, 210, 0.15);
                }

        .btn-fly {
            background: linear-gradient(120deg, #0d47a1, #1976d2);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 13px;
            border-radius: 10px;
            letter-spacing: 0.3px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

            .btn-fly:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 22px rgba(13, 71, 161, 0.3);
                color: #fff;
            }

        .auth-links a {
            text-decoration: none;
            font-size: 14px;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

        /* -------- Divider + Google button (added) -------- */
        .auth-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0;
            color: #9aa7b5;
            font-size: 13px;
        }

            .auth-divider::before,
            .auth-divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #dbe3f0;
            }

        .btn-google {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #fff;
            border: 1.5px solid #dbe3f0;
            color: #1a2a4a;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            width: 100%;
            transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        }

            .btn-google:hover {
                background: #f7f9fc;
                box-shadow: 0 8px 18px rgba(11, 36, 71, 0.08);
                transform: translateY(-1px);
                color: #1a2a4a;
            }

            .btn-google img {
                width: 20px;
                height: 20px;
            }

        @@media (max-width: 991.98px) {
            .auth-visual {
                display: none;
            }

            .auth-form-panel {
                flex: 1 1 100%;
            }
        }
    </style>
}

<div class="auth-split">
    <!-- Left branding / image panel -->
    <div class="auth-visual d-none d-lg-flex">
        <div>
            <div class="plane-mark">&#9992;</div>
            <div class="brand-name">SKYLINE AIRWAYS</div>
        </div>

        <div>
            <div class="tagline">Your journey begins with a single click.</div>
            <div class="subtext">Sign in to manage your bookings, check flight status, and unlock exclusive fares.</div>
            <div class="route-line">
                <span class="dot"></span>
                <span class="line"></span>
                <span>&#9992;</span>
                <span class="line"></span>
                <span class="dot"></span>
            </div>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="auth-form-panel">
        <div class="auth-form-box">
            <div class="text-center mb-4 d-lg-none">
                <div style="font-size:36px; transform: rotate(45deg); display:inline-block;">&#9992;</div>
                <div class="fw-bold fs-4" style="color:#0d47a1;">SKYLINE AIRWAYS</div>
            </div>

            <h1 class="h3 fw-bold mb-1" style="color:#0d2a52;">Welcome Back</h1>
            <p class="text-muted mb-4">Login to continue to your account</p>

            <form asp-action="Login">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="UserNameOrEmail" class="form-label"></label>
                    <input asp-for="UserNameOrEmail" class="form-control" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                    <div>
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label" asp-for="RememberMe">
                            @Html.DisplayNameFor(model => model.RememberMe)
                        </label>
                    </div>
                    <a asp-action="ForgetPassword" class="small">Forgot Password?</a>
                </div>

                <div class="d-grid mt-4">
                    <input type="submit" value="Login" class="btn btn-fly btn-lg" />
                </div>
            </form>

            <!-- ===== Added: Google external login (no changes to existing code above) ===== -->
            <div class="auth-divider">OR CONTINUE WITH</div>

            <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit" name="provider" value="Google" class="btn-google">
                    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" />
                    <span>Continue with Google</span>
                </button>
            </form>
            <!-- ===== End added block ===== -->

            <div class="text-center mt-4">
                <span class="text-muted small">Don't have an account?</span>
                <a asp-action="Register" class="fw-semibold ms-1">Register</a>
            </div>
            <div class="text-center auth-links mt-2">
                <a asp-action="ResendEmailConfirmation" class="text-muted">Resend Email Confirmation</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}
